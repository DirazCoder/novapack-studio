{
  "name": "novapack-studio",
  "version": "1.2.00",
  "description": "NovaByte App Development Studio",
  "author": "DirazCoder",
  "license": "Apache-2.0",
  "main": "index.html",
  "window": {
    "title": "NovaByte Studio",
    "width": 1280,
    "height": 800,
    "min_width": 900,
    "min_height": 600,
    "icon": "assets/icon.png",
    "frame": false,
    "show": true
  },
  "app": {
    "LSApplicationCategoryType": "public.app-category.developer-tools"
  },
  "chromium-args": "--disable-web-security --allow-file-access-from-files",
  "node-remote": "<all_urls>",
  "scripts": {
    "start": "nw .",
    "build": "node build.mjs",
    "bundle:editor": "esbuild src/ui/editor.js --bundle --format=iife --global-name=_CMLoaded --external:typescript --external:@typescript/vfs --outfile=src/ui/editor.bundle.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@noble/hashes": "^2.3.0",
    "@noble/post-quantum": "^0.6.1",
    "@typescript/vfs": "^1.6.4",
    "@valtown/codemirror-ts": "^2.3.1",
    "codemirror": "6.0.2",
    "css": "^3.0.0",
    "devicon": "^2.17.0",
    "dompurify": "^3.4.13",
    "ignore": "^7.0.6",
    "marked": "^18.0.9",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "nw": "^0.114.0-sdk",
    "nw-builder": "^4.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "nw-builder@4.18.0": true,
    "nw@0.114.0-sdk": true
  }
}
