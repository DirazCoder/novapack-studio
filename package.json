{
  "name": "NovaByte Studio",
  "version": "1.2.34",
  "description": "NovaByte App Development Studio",
  "author": "DirazCoder",
  "license": "Apache-2.0",
  "main": "index.html",
  "window": {
    "title": "NovaByte Studio",
    "width": 1280,
    "height": 800,
    "min_width": 900,
    "min_height": 600,
    "icon": "assets/icon.png",
    "frame": false,
    "show": true
  },
  "app": {
    "LSApplicationCategoryType": "public.app-category.developer-tools"
  },
  "chromium-args": "--disable-web-security --allow-file-access-from-files",
  "node-remote": "<all_urls>",
  "scripts": {
    "start": "nw .",
    "build": "node build.mjs",
    "bundle:editor": "esbuild src/ui/editor.js --bundle --format=iife --global-name=_CMLoaded --external:typescript --external:@typescript/vfs --outfile=src/ui/editor.bundle.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@jsonlint/core": "^0.1.1",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@typescript/vfs": "^1.6.6",
    "@valtown/codemirror-ts": "^2.3.1",
    "codemirror": "6.0.2",
    "css": "^3.0.0",
    "csstree-validator": "^4.0.1",
    "devicon": "^2.18.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "htmlhint": "^1.9.2",
    "ignore": "^7.0.14",
    "js-beautify": "^2.0.3",
    "markdown-it": "^15.0.3",
    "parse5": "^8.1.1",
    "semver": "^7.8.6",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "yauzl-promise": "^4.0.0"
  },
  "devDependencies": {
    "nw": "^0.119.2-sdk",
    "nw-builder": "^4.24.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "nw-builder@4.24.2": true,
    "nw@0.119.2-sdk": true
  }
}
