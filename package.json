{
  "name": "novapack-studio",
  "version": "1.2.01",
  "description": "NovaByte App Development Studio",
  "author": "DirazCoder",
  "license": "Apache-2.0",
  "main": "index.html",
  "window": {
    "title": "NovaByte Studio",
    "width": 1280,
    "height": 800,
    "min_width": 900,
    "min_height": 600,
    "icon": "assets/icon.png",
    "frame": false,
    "show": true
  },
  "app": {
    "LSApplicationCategoryType": "public.app-category.developer-tools"
  },
  "chromium-args": "--disable-web-security --allow-file-access-from-files",
  "node-remote": "<all_urls>",
  "scripts": {
    "start": "nw .",
    "build": "node build.mjs",
    "bundle:editor": "esbuild src/ui/editor.js --bundle --format=iife --global-name=_CMLoaded --external:typescript --external:@typescript/vfs --outfile=src/ui/editor.bundle.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@typescript/vfs": "^1.6.5",
    "@valtown/codemirror-ts": "^2.3.1",
    "codemirror": "6.0.2",
    "css": "^3.0.0",
    "devicon": "^2.17.0",
    "dompurify": "^3.4.17",
    "ignore": "^7.0.12",
    "marked": "^18.1.1",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nw": "^0.118.0-sdk",
    "nw-builder": "^4.24.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "nw-builder@4.24.0": true,
    "nw@0.118.0-sdk": true
  }
}
